{
  "name": "show-not-tell",
  "version": "0.1.0",
  "description": "Readable, source-linked code walkthroughs for Pi, with KaTeX math, tables and linted diagrams",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "walkthrough",
    "evidence",
    "code-review",
    "show-not-tell"
  ],
  "files": [
    "extensions/",
    "skills/",
    "docs/",
    "figkit/",
    "README.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "pi": {
    "extensions": [
      "./extensions/walkthrough.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "katex": "^0.16.47"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
